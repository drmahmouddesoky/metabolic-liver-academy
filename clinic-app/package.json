{
  "name": "fatty-liver-clinic",
  "productName": "Fatty Liver Clinic",
  "version": "1.0.0",
  "description": "Comprehensive MASLD / MASH evaluation, medical report and local registry for the clinic desktop",
  "main": "main.js",
  "author": "Metabolic Liver Academy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.metabolicliveracademy.fattyliverclinic",
    "productName": "Fatty Liver Clinic",
    "artifactName": "FattyLiverClinic-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*", "build/icon.png"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "shortcutName": "Fatty Liver Clinic" },
    "mac": { "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }], "category": "public.app-category.medical", "identity": null, "hardenedRuntime": false },
    "dmg": { "sign": false }
  }
}
